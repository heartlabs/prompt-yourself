+/// A small, muted, letter-spaced label above a group of cards
+/// (e.g. "Active", "Completed").
+struct GroupLabel: View {
+    let text: String
+
+    var body: some View {
+        Text(text.uppercased())
+            .font(.echoGroupLabel)
